# HabitHive Backend Environment Variables

# ---- REQUIRED ----
JWT_SECRET=please_set_a_long_random_secret

# ---- OPTIONAL (defaults shown) ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=10080
CORS_ALLOW_ORIGINS=*

# ---- Postgres (provided by platform database container) ----
POSTGRES_URL=localhost:5001
POSTGRES_USER=appuser
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=myapp
POSTGRES_PORT=5001
