# HabitHive Backend Environment Variables

# ---- REQUIRED ----
JWT_SECRET=please_set_a_long_random_secret

# ---- OPTIONAL (defaults shown) ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=10080

# CORS (comma-separated origins). For preview, set this to the frontend preview origin, e.g.:
# CORS_ALLOW_ORIGINS=https://vscode-internal-xxxxx-qa.qa01.cloud.kavia.ai:3000
# Use "*" only for local/dev if you accept the security tradeoff.
CORS_ALLOW_ORIGINS=*

# ---- Postgres ----
# The backend supports EITHER:
#  - db_connection.txt (platform convention, preferred when available), OR
#  - POSTGRES_* env vars below.
#
# POSTGRES_URL may be either:
#  - a full URL: postgresql://user:pass@host:port/db
#  - OR a host/host:port (used with POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB).
POSTGRES_URL=localhost:5001
POSTGRES_USER=appuser
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=myapp
POSTGRES_PORT=5001
